{
  "name": "hirenova",
  "version": "1.0.0",
  "description": "Full-stack hiring platform with job search, applications, employer workflows, admin operations, realtime messaging, notifications, email, and production-readiness checks.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "seed:jobs": "tsx scripts/seed-jobs.ts",
    "dev:client": "npm --prefix client run dev",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:client": "npm --prefix client run lint",
    "build:client": "npm --prefix client run build",
    "check:client": "npm --prefix client run check",
    "check": "npm run typecheck && npm run check:client",
    "check:all": "npm run check"
  },
  "keywords": [
    "hiring-platform",
    "job-board",
    "nextjs",
    "express",
    "mongodb",
    "socket.io",
    "portfolio"
  ],
  "author": "Isakibul",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongoose": "^8.16.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.5",
    "pdf-parse": "^2.4.5",
    "prom-client": "^15.1.3",
    "redis": "^5.6.0",
    "socket.io": "^4.8.3",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
